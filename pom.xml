<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>

	<groupId>net.sasasin.sreader</groupId>
	<artifactId>sreader-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>sreader-parent</name>

	<modules>
		<module>app</module>
	</modules>

	<properties>
		<!-- Override Spring Boot parent default (17) for this project. -->
		<java.version>25</java.version>
		<!-- Keep intentional pins that differ from Spring Boot BOM defaults. -->
		<jooq.version>3.21.7</jooq.version>
		<postgresql.version>42.7.13</postgresql.version>
		<rome.version>2.1.0</rome.version>
		<jsoup.version>1.23.2</jsoup.version>
		<playwright.version>1.62.0</playwright.version>
		<readability4j.version>1.0.8</readability4j.version>
		<spotless-maven-plugin.version>3.9.0</spotless-maven-plugin.version>
		<google-java-format.version>1.28.0</google-java-format.version>
		<maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
		<checkstyle.version>14.1.0</checkstyle.version>
		<jacoco.version>0.8.15</jacoco.version>
		<jacoco.branch.minimum>0.90</jacoco.branch.minimum>
		<tomlj.version>1.1.1</tomlj.version>
	</properties>

	<build>
		<pluginManagement>
			<plugins>
				<!--
				  flyway-maven-plugin is not in Spring Boot parent pluginManagement.
				  Use ${flyway.version} from Spring Boot dependency management (do not redefine it).
				-->
				<plugin>
					<groupId>org.flywaydb</groupId>
					<artifactId>flyway-maven-plugin</artifactId>
					<version>${flyway.version}</version>
				</plugin>
				<plugin>
					<groupId>org.jooq</groupId>
					<artifactId>jooq-codegen-maven</artifactId>
					<version>${jooq.version}</version>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
				<version>${spotless-maven-plugin.version}</version>
				<configuration>
					<java>
						<includes>
							<include>src/main/java/**/*.java</include>
							<include>src/test/java/**/*.java</include>
						</includes>
						<excludes>
							<exclude>src/generated/java/**/*.java</exclude>
							<exclude>**/src/generated/java/**/*.java</exclude>
							<exclude>target/generated-sources/**/*.java</exclude>
							<exclude>**/target/generated-sources/**/*.java</exclude>
						</excludes>
						<googleJavaFormat>
							<version>${google-java-format.version}</version>
							<style>GOOGLE</style>
							<formatJavadoc>true</formatJavadoc>
							<reflowLongStrings>true</reflowLongStrings>
							<reorderImports>true</reorderImports>
						</googleJavaFormat>
						<formatAnnotations />
						<removeUnusedImports />
						<trimTrailingWhitespace />
						<endWithNewline />
					</java>
				</configuration>
				<executions>
					<execution>
						<id>spotless-check</id>
						<phase>validate</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-checkstyle-plugin</artifactId>
				<version>${maven-checkstyle-plugin.version}</version>
				<dependencies>
					<dependency>
						<groupId>com.puppycrawl.tools</groupId>
						<artifactId>checkstyle</artifactId>
						<version>${checkstyle.version}</version>
					</dependency>
				</dependencies>
				<configuration>
					<configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
					<consoleOutput>true</consoleOutput>
					<failsOnError>true</failsOnError>
					<failOnViolation>true</failOnViolation>
					<includeTestSourceDirectory>true</includeTestSourceDirectory>
					<excludes>src/generated/java/**/*.java,**/src/generated/java/**/*.java,target/generated-sources/**/*.java,**/target/generated-sources/**/*.java</excludes>
					<propertyExpansion>checkstyle.suppressions.file=${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</propertyExpansion>
				</configuration>
				<executions>
					<execution>
						<id>checkstyle-check</id>
						<phase>verify</phase>
						<goals>
							<goal>check</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
